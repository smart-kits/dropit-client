{
  "manifest_version": 3,
  "name": "__MSG_extName__",
  "version": "3.1.1",
  "description": "__MSG_extDescription__",
  "default_locale": "en",
  "permissions": ["contextMenus", "storage", "activeTab", "notifications", "scripting", "declarativeNetRequestWithHostAccess"],
  "optional_host_permissions": ["https://*/*", "http://*/*"],
  "background": { "service_worker": "background.js", "type": "module" },
  "action": { "default_popup": "popup.html", "default_title": "__MSG_actionTitle__", "default_icon": { "16": "icon-16.png", "32": "icon-32.png" } },
  "commands": {
    "_execute_action": { "suggested_key": { "default": "Alt+Shift+D" } },
    "drop-now": { "suggested_key": { "default": "Alt+Shift+S" }, "description": "__MSG_cmdDropNow__" }
  },
  "icons": { "16": "icon-16.png", "32": "icon-32.png", "48": "icon-48.png", "128": "icon.png" }
}
