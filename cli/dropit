/** 'zh' for any Chinese locale tag (zh, zh_CN.UTF-8, zh-Hans…), otherwise 'en'. */
const pickLang = (tag) => (/^zh/i.test(tag ?? '') ? 'zh' : 'en');
const LANG = pickLang(process.env.DROPIT_LANG || process.env.LC_ALL || process.env.LC_MESSAGES
  || process.env.LANG || Intl.DateTimeFormat().resolvedOptions().locale);
const t = T[LANG];

// ── Config ──────────────────────────────────────────────────────────────

function load() {
  try { return JSON.parse(fs.readFileSync(CONFIG, 'utf8')); } catch { return { endpoints: DEFAULT_ENDPOINTS }; }
}

/** Written whole, then moved into place: a `send` reading it while `watch` writes never sees half a file */
function save(cfg) {
  fs.mkdirSync(path.dirname(CONFIG), { recursive: true });
  const tmp = `${CONFIG}.${process.pid}.tmp`;
  fs.writeFileSync(tmp, JSON.stringify(cfg, null, 2), { mode: 0o600 });       // holds the token — owner-only
  fs.renameSync(tmp, CONFIG);
}

/** Service addresses worth sending the token to: https, or this machine (for running the service locally) */
const SAFE_BASE = /^(https:\/\/|http:\/\/(localhost|127\.0\.0\.1|\[::1\])(:\d+)?(\/|$))/i;
function endpointsOf(list) {
  const safe = (Array.isArray(list) ? list : []).filter((e) => typeof e === 'string' && SAFE_BASE.test(e));
  return safe.length ? safe : DEFAULT_ENDPOINTS;
}

// ── Network: fall back to the next endpoint, remember the one that works ──

async function api(cfg, method, path_, body, auth = true) {
  const endpoints = endpointsOf(cfg.endpoints);
  let lastErr;
  for (const base of endpoints) {
    try {
      const res = await fetch(base.replace(/\/$/, '') + path_, {
        method,
        headers: {
          ...(auth && cfg.token ? { authorization: `Bearer ${cfg.token}` } : {}),
          ...(body ? { 'content-type': 'application/json' } : {}),
        },
        body: body ? JSON.stringify(body) : undefined,
        signal: AbortSignal.timeout(API_TIMEOUT_MS),
      });
      const answer = await res.json().catch(() => null);
      // Every dropit answer is a JSON object. A 2xx that isn't (a network's sign-in page, a proxy) means this
      // address didn't reach dropit: try the next one rather than report a send that never happened.
      if (res.ok && (answer === null || typeof answer !== 'object')) throw new Error(t.notDropit(res.status));
      const data = answer ?? {};
      if (base !== endpoints[0]) {            // this one works — try it first next time
        cfg.endpoints = [base, ...endpoints.filter((e) => e !== base)];
        save({ ...load(), endpoints: cfg.endpoints });   // only the list: the rest of the file may have changed meanwhile
      }
      if (!res.ok) {
        const err = new Error(withUpgrade(errorText(data.error, data, res.status), data));
        Object.assign(err, { code: data.error, status: res.status, data });
        throw err;
      }
      return data;
    } catch (err) {
      if (err.status) throw err;             // the server answered; not an endpoint problem
      lastErr = err;
    }
  }
  throw new Error(t.offline(endpoints.length, lastErr?.message ?? ''));
}

// ── Commands ────────────────────────────────────────────────────────────

/**
 * What `dropit pair` does here: with a code, join that account; without one, create an account —
 * but only on a machine that hasn't joined yet, or when asked for with --new. A plain `dropit pair`
 * on a joined machine would quietly switch it to a brand-new, empty account.
 */
function pairAction(args, hasToken) {
  const code = args.find((a) => a !== '--new');
  if (code) return { action: 'join', code };
  return hasToken && !args.includes('--new') ? { action: 'refuse' } : { action: 'create' };
}

async function pair(args) {
  const cfg = load();
  const { action, code } = pairAction(args, Boolean(cfg.token));
  if (action === 'refuse') die(t.alreadyJoined);
  const name = `CLI · ${os.hostname()}`;
  // The key this machine had (still working, or already removed) and its fingerprint: pairing again takes
  // the earlier one's place instead of using up another device slot
  const same = { device_key: deviceKey('cli', machineFacts()), ...(cfg.token ? { previous_token: cfg.token } : {}) };
  const res = code
    ? await api(cfg, 'POST', '/v1/pair/claim', { code: code.trim().toUpperCase(), device_name: name, scope: 'full', ...same }, false)
    : await withPow((b) => api(cfg, 'POST', '/v1/accounts', b, false), { device_name: name, ...same },
      { onSolving: () => console.error(t.preparing) });
  save({ ...cfg, token: res.token, device_id: res.device_id, cursor: 0 });
  console.log(code ? t.joined : t.created(res.user_id));
  if (res.replaced && res.replaced.how !== 'issuer') console.log(t.replacedOld(shown(res.replaced.name)));
  await refreshEndpoints(load());
}

/**
 * A puzzle the service may hand out before creating an account: find a number whose hash (with this request's
 * key) starts with enough zero bits. Refused when it asks for more than a laptop should be made to do.
 */
const POW_BITS_MAX = 26;
const POW_SOLVE_MS = 60_000;

function powChallengeOf(data) {
  const c = data?.challenge;
  if (!c || typeof c !== 'object' || c.v !== 1 || c.purpose !== 'accounts.create') return null;
  if (!Number.isInteger(c.bits) || c.bits < 0 || c.bits > POW_BITS_MAX) return null;
  if (typeof c.id !== 'string' || typeof c.salt !== 'string') return null;
  return c;
}

const zeroBits = (digest) => {
  let n = 0;
  for (const b of digest) {
    if (b === 0) { n += 8; continue; }
    return n + Math.clz32(b) - 24;
  }
  return n;
};

/** The number as a string, or null when `limitMs` ran out. Works in short chunks so Ctrl-C and timers stay responsive. */
async function powSolve(challenge, deviceKey, { limitMs = POW_SOLVE_MS, clock = Date.now } = {}) {
  const dkh = deviceKey ? crypto.createHash('sha256').update(deviceKey, 'utf8').digest('hex') : '-';
  const base = crypto.createHash('sha256').update(`${challenge.id}|${challenge.salt}|${dkh}|`, 'utf8');   // the fixed part, hashed once
  const start = clock();
  for (let n = 0; ; ) {
    const chunkEnd = clock() + 20;
    do {
      for (let k = 0; k < 512; k++, n++) {
        const d = base.copy().update(String(n)).digest();
        if (zeroBits(d) >= challenge.bits) return String(n);
      }
    } while (clock() < chunkEnd);
    if (clock() - start > limitMs) return null;
    await new Promise((r) => setImmediate(r));
  }
}

/**
 * Sends the request; on a refusal that carries a puzzle this client can do, solves it and sends the same
 * request once more with the answer. Anything else — no puzzle, an unknown version, too hard, out of time,
 * a second refusal — is the error as it was, so the usual message shows.
 */
async function withPow(send, body, { onSolving, ...opts } = {}) {
  try {
    return await send(body);
  } catch (err) {
    const challenge = err?.code === 'TURNSTILE_REQUIRED' ? powChallengeOf(err.data) : null;
    if (!challenge) throw err;
    onSolving?.();
    const nonce = await powSolve(challenge, body.device_key, opts);
    if (nonce === null) throw err;
    const { v, id, iat, exp, purpose, bits, salt, used, sig } = challenge;
    return await send({ ...body, pow: { v, id, iat, exp, purpose, bits, salt, used, sig, nonce } });
  }
}

/**
 * A fingerprint of this machine (and this config file), so pairing again — after the config was lost, say —
 * takes the place of the earlier pairing instead of using up another device slot. Only a SHA-256 hash is
 * sent, never the facts. It is not a credential: the key (`dk_…`) stays random.
 */
function deviceKey(kind, facts) {
  return crypto.createHash('sha256').update(JSON.stringify([kind, ...facts])).digest('hex');
}

/** Host name, user, OS, CPU, memory, the machine's own ID where the OS offers one, and the config path */
function machineFacts() {
  let user = '';
  try { user = os.userInfo().username; } catch { /* left out */ }
  return [os.hostname(), user, os.platform(), os.arch(), os.cpus()[0]?.model ?? '', os.totalmem(), machineId(), CONFIG];
}

function machineId() {
  try {
    if (process.platform === 'linux') return fs.readFileSync('/etc/machine-id', 'utf8').trim();
    const { execFileSync } = require('node:child_process');
    const run = (cmd, args) => execFileSync(cmd, args, { encoding: 'utf8', timeout: 2000, stdio: ['ignore', 'pipe', 'ignore'] });
    if (process.platform === 'darwin') return run('ioreg', ['-rd1', '-c', 'IOPlatformExpertDevice']).match(/"IOPlatformUUID" = "([^"]+)"/)?.[1] ?? '';
    if (process.platform === 'win32') return run('reg', ['query', 'HKLM\\SOFTWARE\\Microsoft\\Cryptography', '/v', 'MachineGuid']).match(/MachineGuid\s+REG_SZ\s+(\S+)/)?.[1] ?? '';
  } catch { /* not available: the other facts still tell machines apart */ }
  return '';
}

/** Issue a pairing code for another device */
async function newCode() {
  const { code, expires_at } = await api(needToken(), 'POST', '/v1/pair');
  console.log(`${code}\n${t.codeValid(new Date(expires_at).toLocaleTimeString())}`);
}

async function send(args) {
  const cfg = needToken();
  const files = filesOf(args);
  if (files) return sendFiles(cfg, files);

  const raw = args.length ? args.join(' ') : await readStdin();
  if (!raw.trim()) die(t.nothingToSend);
  const kind = /^https?:\/\/\S+$/.test(raw.trim()) ? 'url' : 'text';
  const res = await api(cfg, 'POST', '/v1/ingest', { kind, raw: raw.trim(), source: 'cli', client_ts: Date.now() })
    .catch((err) => (err.code === 'DEDUPED' ? err.data : Promise.reject(err)));
  console.log(res.deduped === true ? t.alreadySent(res.seq) : `✓ #${res.seq}`);
}

/** The files after `-f` (`dropit send -f *.png`), or null when there's no -f. */
function filesOf(args) {
  const i = args.indexOf('-f');
  return i === -1 ? null : args.slice(i + 1);
}

/** Why these files can't be sent, checked before any is: none given, too many, or one that isn't there. */
function filesProblem(files, isFile = fileState, tt = t) {
  if (!files.length) return tt.noFiles;
  if (files.length > FILES_MAX) return tt.tooManyFiles(files.length, FILES_MAX);
  for (const f of files) {
    const state = isFile(f);
    if (state !== 'file') return state === 'missing' ? tt.fileNotFound(f) : tt.notAFile(f);
  }
  return null;
}

function fileState(f) {
  try { return fs.statSync(f).isFile() ? 'file' : 'other'; } catch { return 'missing'; }
}

/** Batch marks for n files: none for one, otherwise {id, i, n} with i counting from 1 — the receiver shows them together. */
function groupsFor(n, id = crypto.randomBytes(12).toString('base64url')) {
  if (n < 2) return Array.from({ length: n }, () => null);
  return Array.from({ length: n }, (_, k) => ({ id, i: k + 1, n }));
}

/**
 * One after the other, a line each. A failure stops there: what went through stays sent,
 * the reason is printed with the file's name, and the exit code is 1.
 */
async function sendFiles(cfg, files) {
  const problem = filesProblem(files);
  if (problem) die(problem);
  // Several files: check the sizes first, so a file that's too big doesn't stop the batch halfway
  if (files.length > 1) {
    const limit = (await api(cfg, 'GET', '/v1/me').catch(() => null))?.item_bytes_limit;
    const big = limit && files.find((f) => fs.statSync(f).size > limit);
    if (big) die(`${path.basename(big)}: ${t.tooLarge(mb(limit))}`);
  }
  const groups = groupsFor(files.length);
  for (const [k, file] of files.entries()) {
    try {
      await sendFile(cfg, file, groups[k]);
    } catch (err) {
      if (files.length === 1) die(err.message);
      die(`${path.basename(file)}: ${err.message}\n${t.batchStopped(k, files.length)}`);
    }
  }
}

/** Three-step upload: request an upload URL → PUT the file → confirm */
async function sendFile(cfg, file, group) {
  const stat = fs.statSync(file);
  const start = await api(cfg, 'POST', '/v1/ingest/blob', {
    kind: kindOf(file), filename: path.basename(file), size: stat.size,
    mime: mimeOf(file), source: 'cli', client_ts: Date.now(), ...(group ? { group } : {}),
  }).catch((err) => (err.code === 'DEDUPED' ? err.data : Promise.reject(err)));
  if (start.deduped) return console.log(t.alreadySent(start.seq));

  // Streamed: the file is never read fully into memory.
  const put = await fetch(start.upload_url, {
    method: 'PUT',
    headers: { 'content-type': mimeOf(file), 'content-length': String(stat.size) },
    body: fs.createReadStream(file),
    duplex: 'half',
  }).catch((err) => { throw new Error(t.uploadFailedNet(err.message)); });
  if (!put.ok) throw new Error(t.uploadFailedHttp(put.status));   // fail loudly, never pretend it worked

  // The number from the first step is a placeholder while uploading; the item's real # comes back here.
  const done = await api(cfg, 'POST', `/v1/ingest/blob/${start.seq}/done`);
  console.log(`✓ #${done.seq} ${path.basename(file)} ${(stat.size / 1024).toFixed(0)} KB`);
}

/** `--name <positive number>` out of args (removed from them), or null when absent */
function numberFlag(args, name) {
  const i = args.indexOf(name);
  if (i < 0) return null;
  const n = Number(args[i + 1]);
  args.splice(i, 2);
  if (!Number.isInteger(n) || n < 1) throw new Error(t.badFlag(name));
  return n;
}

/** Local-folder consumer: writes incoming items as files, in real time */
async function watch(args) {
  const cfg = needToken();
  // Everything after --exec is the command and its arguments, so it's taken out before any flag is read
  let exec = null;
  const at = args.indexOf('--exec');
  if (at >= 0) {
    exec = args.splice(at).slice(1);
    if (!exec.length) die(t.ag.execNeedsCommand);
  }
  const noHandlers = args.includes('--no-handlers');
  if (noHandlers) args.splice(args.indexOf('--no-handlers'), 1);
  const from = numberFlag(args, '--from');
  const days = numberFlag(args, '--days');
  let recent = null;                                        // this run only; 0 is allowed (= all), which numberFlag does not take
  const ri = args.indexOf('--recent');
  if (ri >= 0) {
    recent = intIn(String(args[ri + 1] ?? ''), 0, 1000);
    if (recent === null) die(t.ag.recentBad);
    args.splice(ri, 2);
  }
  const dir = path.resolve(args[0] ?? cfg.folder ?? path.join(os.homedir(), 'dropit'));
  fs.mkdirSync(dir, { recursive: true });
  save({ ...cfg, folder: dir });
  console.log(t.folder(tildePath(dir)));

  // Pulling again from a point: files already in the folder are kept (writeItem skips them),
  // so this fills in what's missing. The server's snapshot of this device's position only moves
  // forward on its own, so it's reset too.
  const state = {
    token: cfg.token, cursor: cfg.cursor ?? 0, since: 0, syncing: false, again: false,
    socket: null, connecting: false, retryTimer: null, retry: 0, openedAt: 0, lastBeat: 0, until: null, off: null,
    exec, noHandlers, recent, queue: newQueue(), ctx: watchContext(),
  };
  if (from || days) {
    state.cursor = from ? from - 1 : 0;
    state.since = days ? Date.now() - days * 86_400_000 : 0;
    await api(cfg, 'POST', '/v1/cursor/reset', { to_seq: state.cursor });
  }
  const sync = () => pullInto(dir, state);

  await sync();
  if (typeof WebSocket === 'undefined') {
    console.log(t.noWebSocket);
    return;
  }
  // Without real-time there's nothing to wait for: catching up once is all a watch can do (stopRealtime exits).
  await connect(state, sync);
  setInterval(() => heartbeat(state, sync), HEARTBEAT_MS);
  process.on('SIGINT', () => { state.socket?.close(); process.exit(0); });
}

/**
 * Catch up from the cursor. A push that comes in while this runs isn't dropped: it asks for one more round
 * once this one is done, since the page already fetched may not hold the new item.
 */
async function pullInto(dir, state) {
  if (state.syncing) { state.again = true; return; }
  state.syncing = true;
  const batch = [];                                // what this pull wrote: only the newest few are handed on (see handOn)
  try {
    do {
      state.again = false;
      for (let hasMore = true; hasMore; ) {
        const cfg = load();
        if (cfg.token !== state.token) adopt(state, cfg);
        const since = state.since ? `&since=${state.since}` : '';
        const page = await api(cfg, 'GET', `/v1/pull?after=${state.cursor}&limit=200${since}`);
        for (const item of page.items) {
          batch.push({ item, written: await writeItem(dir, item) });   // handed on at the end, newest few only: receiving never waits for a command or an agent
          state.cursor = item.seq;                 // item by item: a failure stops exactly there
        }
        state.cursor = page.next_after;            // advance only after writing: a duplicate beats a lost item
        saveCursor(state);
        hasMore = page.has_more;
      }
    } while (state.again);
  } catch (err) {
    if (AUTH_LOST.has(err.code)) stopWatch(err.message);
    saveCursor(state);                             // keep what did get written
    console.error(t.pullFailed(err.message));
  } finally {
    state.syncing = false;
    handOn(state, dir, batch);                     // also when the pull failed half way: what was written still goes on
  }
}

/**
 * What a pull wrote goes to the command and the rules. When a lot came at once (a first run, a long time away, `--from`),
 * only the newest few do: everything is still written, but a backlog does not start a hundred agent runs. How many: `--recent`,
 * else the rules file (`dropit handlers recent`), else 3; 0 means all.
 */
function handOn(state, dir, batch) {
  try {
    const list = batch.filter((b) => b.written?.file);
    let n = state.recent;
    if (n == null) n = readAgents().data?.recent ?? RECENT_DEFAULT;
    let keep = list;
    if (n > 0 && list.length > n) {
      keep = list.slice(-n);
      if (state.exec || !state.noHandlers) console.log(t.ag.backlogSkipped(list.length - n, n));
    }
    for (const { item, written } of keep) afterWrite(state, dir, item, written);
  } catch (err) {
    console.error(shown(err.message));
  }
}

/** The cursor belongs to the account it was read under: if `dropit pair` switched accounts meanwhile, leave the file alone */
function saveCursor(state) {
  const cfg = load();
  if (cfg.token === state.token) save({ ...cfg, cursor: state.cursor });
}

/**
 * `dropit pair` ran in another terminal while watch was running. Receive from the new account, from where
 * pairing put it, over a new real-time connection — the open one is the old account's.
 */
function adopt(state, cfg) {
  if (!cfg.token) stopWatch(t.notPaired);
  state.token = cfg.token;
  state.cursor = cfg.cursor ?? 0;
  state.since = 0;
  console.log(t.accountChanged);
  if (state.socket) dropSocket(state);
}

/**
 * The token no longer works (removed from the account, or send-only). Trying again can't fix that, so stop.
 * Exit code 0 on purpose: the launch agent and systemd unit in the README restart watch only after a failure,
 * and restarting this would just ask the same question every few seconds.
 */
function stopWatch(msg) {
  console.error(t.stopped(msg));
  process.exit(0);
}

async function writeItem(dir, item) {
  const stamp = new Date(item.created_at).toISOString().slice(0, 10);
  if (item.url) {                                  // binary item: fetch from its signed download URL
    const name = `${stamp}-${item.seq}-${sanitize(item.meta?.filename ?? 'file')}`;
    const target = path.join(dir, name);
    if (fs.existsSync(target)) return { file: target, fresh: false };
    // A failed download leaves a note in its place and moves on: stopping would hold back everything
    // after it, and a network that can't reach the file store never recovers on its own. The note says
    // how to fetch it again; when a later pull succeeds, the note goes.
    const note = path.join(dir, `${stamp}-${item.seq}.md`);
    let reason;
    try {
      const res = await fetch(item.url, { signal: AbortSignal.timeout(DOWNLOAD_TIMEOUT_MS) });
      if (res.ok) {
        fs.writeFileSync(target, Buffer.from(await res.arrayBuffer()));
        fs.rmSync(note, { force: true });
        console.log(`↓ ${name}`);
        return { file: target, fresh: true };
      }
      reason = res.status === 404 ? t.missingFile(name) : t.downloadFailed(item.seq, `HTTP ${res.status}`);
    } catch (err) {
      reason = t.downloadFailed(item.seq, err.message);
    }
    fs.writeFileSync(note, `---\ndropit_seq: ${item.seq}\nkind: ${yamlValue(item.kind)}\nsource: ${yamlValue(item.source)}\n---\n\n`
      + `${reason}\n\n${t.retryHint(item.seq)}\n`);
    console.error(reason);
    return null;
  }
  const target = path.join(dir, `${stamp}-${item.seq}.md`);
  if (fs.existsSync(target)) return { file: target, fresh: false };
  fs.writeFileSync(target, `---\ndropit_seq: ${item.seq}\nkind: ${yamlValue(item.kind)}\nsource: ${yamlValue(item.source)}\n`
    + `created: ${new Date(item.created_at).toISOString()}\n---\n\n${markdownOf(item)}\n`);
  console.log(`↓ ${path.basename(target)}`);
  return { file: target, fresh: true };
}

// ── Markdown body of a text or link item ────────────────────────────────

const HTTP_URL = /^https?:\/\/\S+$/i;

/** Link text: no brackets or line breaks; a backslash is escaped so it can't swallow the closing `]`. */
const linkText = (s) => String(s ?? '').replace(/[[\]]/g, '').replace(/\s*[\r\n]+\s*/g, ' ').trim()
  .replace(/\\/g, '\\\\');

/** Link target: wrapped in <…> when it has spaces, brackets or backslashes, which would end or bend a bare one. */
function linkTarget(url) {
  const u = url.replace(/\r/g, '%0D').replace(/\n/g, '%0A');
  return /[\s()<>\\]/.test(u) ? `<${u.replace(/[\\<>]/g, '\\$&')}>` : u;
}

/** Host name of an http(s) URL, or null when it isn't one. */
function httpHost(url) {
  if (typeof url !== 'string' || !/^https?:\/\//i.test(url)) return null;
  try { return new URL(url).hostname || null; } catch { return null; }
}

/**
 * What goes under the front matter.
 *   A link with a title    → [title](url), then the description as a quote
 *   Anything with a source → its body, then "— [source title](source url)" (the host name when untitled)
 * Items with neither come out exactly as sent.
 */
function markdownOf(item) {
  const meta = item.meta ?? {};
  let body = `${item.raw}`;
  const url = String(item.raw ?? '').trim();
  const title = linkText(meta.title);
  if (title && HTTP_URL.test(url)) {               // kind 'url' or not: only a lone http(s) address becomes a link
    body = `[${title}](${linkTarget(url)})`;
    const desc = String(meta.description ?? '').trim();
    if (desc) body += `\n\n${desc.split(/\r?\n/).map((l) => `> ${l}`.trimEnd()).join('\n')}`;
  }
  const host = httpHost(meta.from?.url);
  if (host) body = `${body.trimEnd()}\n\n— [${linkText(meta.from.title) || linkText(host)}](${linkTarget(meta.from.url)})`;
  return body;
}

// ── Real-time (same liveness logic as the Obsidian plugin) ──────────────

/**
 * One attempt at a time: while a connection is open, being opened, or waiting to be retried, nothing starts another.
 * (1.0.0 let each heartbeat start a new retry chain, so a service that kept saying no got asked more often every minute.)
 */
async function connect(state, sync) {
  if (state.socket || state.connecting || state.off) return;
  clearTimeout(state.retryTimer);
  state.retryTimer = null;
  state.connecting = true;
  const cfg = load();
  try {
    const { ticket, realtime_until: until } = await api(cfg, 'POST', '/v1/ws/ticket');
    state.until = until ?? null;                 // null = paid, always on; otherwise the end of the trial
    state.ticketDay = Math.floor(Date.now() / 86_400_000);   // the trial's real-time is granted per UTC day
    const base = endpointsOf(cfg.endpoints)[0].replace(/^http/, 'ws').replace(/\/$/, '');
    // can=end: this client reads why it's being let go (the account's connections are full) and waits, instead of
    // retrying at once — so the service may tell it, rather than refuse the connection without a reason
    const socket = new WebSocket(`${base}/v1/ws?ticket=${encodeURIComponent(ticket)}&can=end`);
    state.socket = socket;
    state.lastBeat = Date.now();                 // a handshake that never finishes counts as stale too
    socket.onopen = () => {
      if (state.socket !== socket) return;
      state.connecting = false;
      state.openedAt = Date.now();
      state.lastBeat = Date.now();
      console.log(state.until == null ? t.wsConnected : t.wsConnectedTrial(trialLeft(state.until)));
      sync();                                    // whatever arrived while this wasn't connected
    };
    socket.onmessage = (ev) => {
      if (state.socket !== socket) return;
      state.lastBeat = Date.now();
      if (ev.data === 'pong') return;
      let msg = null;
      try { msg = JSON.parse(ev.data); } catch { /* not JSON: an older server's message */ }
      if (msg?.end === 'too_many') return void pause(state, sync, msg.limit);
      // The last push of a day whose real-time spots ran out says so; the server then closes the socket.
      // Off right away, so the close that follows doesn't reconnect; the notice waits for the catch-up it announces
      if (msg?.end === 'trial_full') state.off = 'trial_full';
      const pulled = sync();
      if (msg?.end === 'trial_full') pulled.finally(() => stopRealtime(state, sync, 'trial_full'));
    };
    socket.onclose = () => {
      if (state.socket !== socket) return;       // already let go of (stale, another account, paused)
      // A connection that held for a while starts the backoff over; one closed right after opening doesn't,
      // so being let go again and again slows down instead of coming back every second
      if (state.openedAt && Date.now() - state.openedAt >= STEADY_MS) state.retry = 0;
      dropSocket(state);
      reconnect(state, sync);
    };
    socket.onerror = () => socket.close();
  } catch (err) {
    state.connecting = false;
    if (err.code === 'WS_REQUIRES_PAID') return stopRealtime(state, sync, err.data?.reason, err.data);
    if (AUTH_LOST.has(err.code)) return stopWatch(err.message);
    console.error(t.wsFailed(err.message));
    reconnect(state, sync, err.data?.retry_after);
  }
}

/** Let go of the connection without waiting for its close event: one the server closes can sit in CLOSING for a long time */
function dropSocket(state) {
  const socket = state.socket;
  state.socket = null;
  state.connecting = false;
  state.openedAt = 0;
  try { socket?.close(); } catch { /* already closed */ }
}

/** The account already has as many real-time connections as it may: say so once, and try again later */
function pause(state, sync, limit) {
  dropSocket(state);
  if (!state.paused) console.log(t.wsTooMany(limit ?? '?'));
  state.paused = true;
  clearTimeout(state.retryTimer);
  state.retryTimer = setTimeout(() => { state.retryTimer = null; connect(state, sync); }, TOO_MANY_WAIT_MS * (1 + Math.random() / 2));
}

/**
 * Real-time is off. trial_full: spots are counted per UTC day, so wait and reconnect a little after midnight
 * (spread over ten minutes). Otherwise (trial over, or not in the plan) there's nothing to wait for: exit.
 */
function stopRealtime(state, sync, why, data = null) {
  state.off = why ?? 'plan';
  dropSocket(state);
  if (why !== 'trial_full') {
    // The service gives a free account the way past this (Paid is real-time for good); nobody else gets a link
    console.log(withUpgrade(why === 'trial_over' ? t.wsTrialOver : t.wsNotIncluded, data ?? {}));
    // An agent still working on something that arrived gets to finish first
    if (state.queue?.pending) { state.queue.tail.then(() => process.exit(0)); return 'plan'; }
    process.exit(0);                             // also when it happens on a reconnect, not just at start
  }
  console.log(t.wsTrialFull);
  const DAY = 86_400_000;
  clearTimeout(state.retryTimer);                // one retry, however many times today said no
  state.retryTimer = setTimeout(() => { state.retryTimer = null; state.off = null; connect(state, sync); },
    DAY - (Date.now() % DAY) + Math.random() * 600_000);
  return 'full';
}

/** "3 days left" — counts whole days up, under a day says so */
function trialLeft(until, tt = t, now = Date.now()) {
  const left = until - now;
  return tt.daysLeft(left < 86_400_000 ? 0 : Math.ceil(left / 86_400_000));
}

/**
 * The next attempt, replacing any already waiting. Exponential backoff with a random half on top, so that many
 * machines that lost the service at once don't all come back in the same second; never sooner than the
 * service asked for (retry_after, in seconds).
 */
function reconnect(state, sync, retryAfter) {
  if (state.off) return;
  const base = Math.max(BACKOFF_MS[Math.min(state.retry++, BACKOFF_MS.length - 1)], (Number(retryAfter) || 0) * 1000);
  clearTimeout(state.retryTimer);
  state.retryTimer = setTimeout(() => { state.retryTimer = null; connect(state, sync); }, base * (1 + Math.random() / 2));
}

/** After sleep/wake a socket often goes stale while readyState still says OPEN — ping and time it. */
function heartbeat(state, sync) {
  if (state.off) return;
  // While on the trial, ask for a fresh ticket (a) a little after each UTC midnight — real-time is granted per day and
  // a socket can stay open for days — and (b) when the trial ends by the local clock, at most hourly: the server decides,
  // since the plan may have been upgraded meanwhile (a ticket with no end), or it really ended (403 trial_over → exit).
  if (state.until != null && state.socket) {
    const now = Date.now();
    const left = state.until - now;
    if (left > 0 && left < 86_400_000 && !state.warned) { state.warned = true; console.log(t.wsTrialEnding); }
    state.jitter ??= Math.random() * 600_000;
    const newDay = Math.floor((now - state.jitter) / 86_400_000) > state.ticketDay;
    const ended = left <= 0 && now - (state.recheckAt ?? 0) > 3_600_000;
    if (newDay || ended) {
      if (ended) state.recheckAt = now;
      dropSocket(state);
      return void connect(state, sync);
    }
  }
  if (!state.socket) {
    if (!state.connecting && !state.retryTimer) connect(state, sync);   // nothing on the way: try now
    return;
  }
  if (Date.now() - state.lastBeat > STALE_MS) {  // silent too long, or a handshake that never finished
    dropSocket(state);
    return void reconnect(state, sync);
  }
  if (state.socket.readyState !== 1) return;     // still opening
  if (Date.now() - state.openedAt >= STEADY_MS) state.paused = false;   // held a while: a later "full" is news again
  try { state.socket.send('ping'); } catch { dropSocket(state); reconnect(state, sync); }
}

async function me() {
  console.log(meLine(await api(needToken(), 'GET', '/v1/me')));
}

/**
 * "free · 1/3 devices · 0.0/30 MB · files up to 10 MB · real-time trial: 3 days left".
 * realtime_until: null = always on; a time = the trial's end (passed or not). An answer without it
 * (an older service) falls back to ws_available; one without item_bytes_limit leaves that part out.
 */
function meLine(m, tt = t, now = Date.now()) {
  const until = m.realtime_until;
  const rt = until === undefined ? (m.ws_available ? tt.rtOn : tt.rtOff)
    : until === null ? tt.rtOn
      : until > now ? tt.rtTrial(trialLeft(until, tt, now)) : tt.rtTrialOver;
  return [
    m.plan,
    tt.meDevices(m.devices_used, m.devices_limit ?? '∞'),
    `${(m.bytes_used / 1048576).toFixed(1)}/${(m.bytes_limit / 1048576).toFixed(0)} MB`,
    ...(m.item_bytes_limit ? [tt.meFiles(mb(m.item_bytes_limit))] : []),
    rt,
  ].join(' · ');
}

async function devices() {
  const { devices } = await api(needToken(), 'GET', '/v1/devices');
  for (const d of devices) {
