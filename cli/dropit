const STALE_MS = 150_000;
const BACKOFF_MS = [1_000, 2_000, 5_000, 15_000, 30_000, 60_000];
const STEADY_MS = 60_000;                    // a connection that lasted this long starts the backoff over
const TOO_MANY_WAIT_MS = 15 * 60_000;        // the account's real-time connections are full: try again after this
const API_TIMEOUT_MS = 30_000;
const DOWNLOAD_TIMEOUT_MS = 30 * 60_000;     // a backstop for a download that stops moving, not a size limit
// Answers that won't change by trying again: watch stops instead of retrying forever
const AUTH_LOST = new Set(['INVALID_TOKEN', 'DEVICE_REVOKED', 'SCOPE_INSUFFICIENT']);
const FILES_MAX = 10;                        // files sent together — the same in every client
const UPLOAD_CONCURRENCY = 3;                // files in flight at once when several are sent together
const PREFETCH_WINDOW = 3;                   // watch: downloads running ahead of the one being written
const PREFETCH_BYTES = 64 * 1024 * 1024;     // watch: most that the window holds in memory (a bigger single file goes alone)
const BATCH_QUIET_MS = 90_000;               // watch: a batch still short of its count is handed to the rule this long after its last item arrived…
const BATCH_MAX_MS = 300_000;                // …and at the latest this long after its first
const NOTES_WAIT_MS = 3_000;                 // watch: at most this long is spent reading the account before connecting
const BATCH_KEEP_MS = 24 * 3_600_000;        // watch: a handled batch is remembered this long, so a member that comes late is not run on its own
const VERSION = '1.2.0';                     // released as cli-<VERSION> on GitHub; bump when this file changes

// ── Language ────────────────────────────────────────────────────────────
// English by default; Simplified Chinese when the environment asks for it.
// Override with DROPIT_LANG=en or DROPIT_LANG=zh.

/** An account id as shown on screen: its first six characters, never the whole thing */
const idShort = (id) => `${String(id ?? '').slice(0, 6)}…`;

/** Name this machine goes by: `CLI · <host name>`, cut to what the service accepts (48 characters, 64 bytes at most) */
function deviceNameOf(host) {
  let chars = Array.from(`CLI · ${host}`).slice(0, 48);
  while (chars.length > 1 && Buffer.byteLength(chars.join('')) > 64) chars.pop();
  return chars.join('');
}

