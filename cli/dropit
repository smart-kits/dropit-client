/**
 * Refresh the endpoint list and persist it.
 * **Merge, don't replace** — the current endpoint just worked; if the returned list were
 * wrong, replacing it would drop the only working address. Known-good goes first.
 */
async function refreshEndpoints(cfg) {
  try {
    const { endpoints } = await api(cfg, 'GET', '/v1/endpoints', null, false);
    if (!endpoints?.length) return;
    const current = (load().endpoints ?? DEFAULT_ENDPOINTS)[0];
    save({ ...load(), endpoints: [...new Set([current, ...endpoints])] });
